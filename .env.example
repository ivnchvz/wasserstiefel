# Usernames are committed in src/lib/config.ts, since they are public anyway
# and appear in the profile links on the page. Set them here only to override.
# LETTERBOXD_USERNAME=
# BACKLOGGD_USERNAME=
# LASTFM_USERNAME=
# STEAM_ID=

# Keys stay out of the repository, which is public.

# Last.fm — reads your last-played track.
# Apple Music scrobbles here via Marvis Pro (iOS), NepTunes (macOS) or Cider.
# Get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Steam — recently played games and the in-game banner.
# Key: https://steamcommunity.com/dev/apikey
# Your profile's game details must be set to Public.
STEAM_API_KEY=

# /admin on the live site. Locally admin is open and writes to these files.
# ADMIN_PASSWORD: long and random; the login page is on a public URL.
ADMIN_PASSWORD=
# GITHUB_TOKEN: a fine-grained token for this repository only, with
# "Contents: Read and write". Saves become commits, which Vercel deploys.
GITHUB_TOKEN=
